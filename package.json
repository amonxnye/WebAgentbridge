{
  "name": "webbridge",
  "version": "0.1.0",
  "description": "Agentic Web Interface Platform — converts any website into a structured MCP endpoint",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "register": "ts-node src/cli/register.ts",
    "worker": "ts-node src/queue/worker.ts",
    "db:migrate": "ts-node src/db/migrate.ts",
    "install:browsers": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "bullmq": "^5.7.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "ioredis": "^5.3.0",
    "pg": "^8.11.0",
    "playwright": "^1.42.0",
    "slugify": "^1.6.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "@types/uuid": "^9.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}
