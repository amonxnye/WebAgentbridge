# Anthropic API key — required for semantic classification
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL connection string
DATABASE_URL=postgresql://webbridge:webbridge@localhost:5432/webbridge

# Redis connection string (used by BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Server configuration
PORT=3000
HOST=localhost

# Public base URL of this WebBridge instance (used in generated agent.json)
PUBLIC_BASE_URL=http://localhost:3000

# Crawl settings
DEFAULT_CRAWL_DEPTH=3
CRAWL_PAGE_TIMEOUT_MS=30000
CRAWL_DELAY_MS=500

# Log level: debug | info | warn | error
LOG_LEVEL=info
